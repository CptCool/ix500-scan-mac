#!/usr/bin/env bash
# Scan from a Fujitsu/PFU ScanSnap iX500 over USB (SANE) into a searchable PDF.
#
# Usage: scan-ix500 [--mode color|gray|bw] [--dpi N] [--simplex] [--lang deu+eng]
#                   [--save pdf|pdf-pages|jpeg|png] [--out DIR] [--no-ocr] [--no-df] [--keep-blank]
#
# --save pdf        all pages in one PDF (default)
# --save pdf-pages  one PDF per page, in a folder named after the scan
# --save jpeg|png   one image per page, in a folder named after the scan
# OCR applies to PDFs only. Blank pages are dropped unless --keep-blank is given.
#
# Double-feed detection (ultrasonic) is on by default: the scanner stops when it
# pulls in two sheets at once. --no-df turns it off (envelopes, cards, stickers).
# On a double feed, paper jam, open cover, hardware error or lost connection the
# pages scanned before it are still saved, and the script exits with 8.
#
# The last line of output is "OUTPUT: <path>" (the file, or the folder for
# per-page output) whenever something was saved.

set -uo pipefail

# GUI apps don't inherit the shell PATH
export PATH="$PATH:/opt/homebrew/bin:/usr/local/bin"

mode="color"
dpi=300
source="ADF Duplex"
lang="deu+eng"
outdir="$HOME/Documents/Scans"
ocr=1
df=1
save="pdf"
skip=10

while (( $# )); do
  case "$1" in
    --mode)    mode="$2"; shift 2 ;;
    --dpi)     dpi="$2"; shift 2 ;;
    --simplex) source="ADF Front"; shift ;;
    --lang)    lang="$2"; shift 2 ;;
    --out)     outdir="$2"; shift 2 ;;
    --no-ocr)  ocr=0; shift ;;
    --no-df)   df=0; shift ;;
    --save)    save="$2"; shift 2 ;;
    --keep-blank) skip=0; shift ;;
    -h|--help) sed -n '2,19p' "$0"; exit 0 ;;
    *) echo "Unknown option: $1" >&2; exit 2 ;;
  esac
done

case "$mode" in
  color) sane_mode="Color" ;;
  gray)  sane_mode="Gray" ;;
  bw)    sane_mode="Lineart" ;;
  *) echo "Unknown mode: $mode (color|gray|bw)" >&2; exit 2 ;;
esac

case "$save" in
  pdf|pdf-pages|jpeg|png) ;;
  *) echo "Unknown save format: $save (pdf|pdf-pages|jpeg|png)" >&2; exit 2 ;;
esac
[[ "$save" == jpeg || "$save" == png ]] && ocr=0

for tool in scanimage img2pdf; do
  command -v "$tool" >/dev/null || { echo "Missing $tool. Run: brew install sane-backends img2pdf ocrmypdf tesseract-lang" >&2; exit 3; }
done
(( ocr )) && ! command -v ocrmypdf >/dev/null && { echo "Missing ocrmypdf. Run: brew install ocrmypdf tesseract-lang" >&2; exit 3; }

device="$(scanimage -f '%d%n' 2>/dev/null | grep -m1 '^fujitsu:')"
if [[ -z "$device" ]]; then
  echo "No iX500 found. Is it connected via USB, switched on (feeder open), and ScanSnap Home quit?" >&2
  exit 4
fi
echo "Device: $device"

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

if (( df )); then
  df_opts=(--df-action Stop --df-thickness=yes --df-length=yes)
else
  df_opts=(--df-action Continue)
fi

echo "Scanning ($sane_mode, $dpi dpi, $source, double-feed detection $( (( df )) && echo on || echo off )) ..."
# scanimage exits non-zero when the feeder runs empty, which is the normal end of a batch
# Debug level 2 makes the backend log the scanner's sense codes (jam, double feed, ...)
SANE_DEBUG_FUJITSU=2 scanimage -d "$device" --source "$source" --mode "$sane_mode" --resolution "$dpi" \
  --swdeskew=yes --swcrop=yes --swskip "$skip" "${df_opts[@]}" \
  --format=tiff --batch="$tmp/page-%03d.tif" > "$tmp/scan.log" 2>&1
grep '^Scanned page' "$tmp/scan.log"

stopped=0
problem=""
if grep -q 'Medium error: double feed' "$tmp/scan.log"; then
  problem="DOUBLE FEED: two sheets went in at once. Separate them and rescan the rest."
elif grep -q 'Medium error: paper jam\|Document feeder jammed' "$tmp/scan.log"; then
  problem="PAPER JAM: open the lid, remove the sheet and rescan the rest."
elif grep -q 'Medium error: cover open\|Scanner cover is open' "$tmp/scan.log"; then
  problem="COVER OPEN: close the scanner lid."
elif grep -q 'Hardware error: ' "$tmp/scan.log"; then
  problem="HARDWARE ERROR: $(grep -m1 -o 'Hardware error: .*' "$tmp/scan.log")"
elif grep -q 'Error during device I/O' "$tmp/scan.log"; then
  problem="CONNECTION LOST: check the USB cable and power."
fi
if [[ -n "$problem" ]]; then
  stopped=1
  echo "$problem" >&2
fi

shopt -s nullglob
pages=("$tmp"/page-*.tif)
if (( ${#pages[@]} == 0 )); then
  (( stopped )) && exit 8
  echo "No pages scanned. Is there paper in the feeder?" >&2
  exit 5
fi
echo "${#pages[@]} page(s) scanned"

mkdir -p "$outdir"
name="Scan $(date '+%Y-%m-%d %H.%M.%S')"

# Write one PDF from the given TIFFs, with OCR if enabled
make_pdf() {
  local dest="$1"; shift
  img2pdf "$@" -o "$tmp/raw.pdf" || exit 6
  if (( ocr )); then
    ocrmypdf -q -l "$lang" --rotate-pages --optimize 1 "$tmp/raw.pdf" "$dest" || exit 7
  else
    mv "$tmp/raw.pdf" "$dest"
  fi
}

(( ocr )) && echo "Running OCR ($lang) ..."
case "$save" in
  pdf)
    out="$outdir/$name.pdf"
    make_pdf "$out" "${pages[@]}"
    ;;
  pdf-pages)
    out="$outdir/$name"
    mkdir -p "$out"
    n=0
    for page in "${pages[@]}"; do
      n=$((n + 1))
      make_pdf "$out/$(printf 'Seite %03d' "$n").pdf" "$page"
    done
    ;;
  jpeg|png)
    out="$outdir/$name"
    mkdir -p "$out"
    ext="$save"; [[ "$save" == jpeg ]] && ext="jpg"
    n=0
    for page in "${pages[@]}"; do
      n=$((n + 1))
      sips -s format "$save" "$page" --out "$out/$(printf 'Seite %03d' "$n").$ext" >/dev/null || exit 6
    done
    ;;
esac

echo "OUTPUT: $out"
(( stopped )) && exit 8
exit 0
